pragma solidity ^0.8.28;

/// @title CloudAuction
/// @notice A sealed-bid commit-reveal auction for one demo cloud resource.
/// @dev Bid values are price units chosen by the demo; this contract does not custody ETH.
contract CloudAuction {
    enum Phase {
        Commit,
        Reveal,
        Finalized
    }

    struct Resource {
        uint256 id;
        string description;
        bool allocated;
        address allocatedTo;
    }

    struct Bidder {
        bytes32 commitment;
        bool committed;
        bool revealed;
        uint256 bid;
    }

    address public immutable auctioneer;
    Phase public phase;
    uint256 public immutable commitEnd;
    uint256 public revealEnd;
    uint256 public immutable revealDuration;
    uint256 public immutable maxBid;
    Resource private resource;

    mapping(address => Bidder) public bidders;
    address[] private bidderAddresses;

    // These remain zero until finalizeAuction. They are never updated in revealBid.
    uint256 public highestBid;
    address public winner;

    event BidCommitted(address indexed bidder, bytes32 indexed commitment);
    event RevealPhaseStarted(uint256 revealEnd);
    event BidRevealed(address indexed bidder);
    event AuctionFinalized(address indexed winner, uint256 winningBid, uint256 resourceId);

    modifier onlyAuctioneer() {
        require(msg.sender == auctioneer, "Only the auctioneer can call this");
        _;
    }

    constructor(
        uint256 resourceId,
        string memory resourceDescription,
        uint256 commitDurationSeconds,
        uint256 revealDurationSeconds,
        uint256 maxBidAmount
    ) {
        require(commitDurationSeconds > 0, "Commit duration must be positive");
        require(revealDurationSeconds > 0, "Reveal duration must be positive");
        require(maxBidAmount > 0, "Maximum bid must be positive");

        auctioneer = msg.sender;
        phase = Phase.Commit;
        commitEnd = block.timestamp + commitDurationSeconds;
        revealDuration = revealDurationSeconds;
        maxBid = maxBidAmount;
        resource = Resource({
            id: resourceId,
            description: resourceDescription,
            allocated: false,
            allocatedTo: address(0)
        });
    }

    /// @notice Store H(bid, nonce) during the commit window. The bid is never sent here.
    function commitBid(bytes32 commitment) external {
        require(phase == Phase.Commit, "Commit phase is closed");
        require(block.timestamp < commitEnd, "Commit deadline has passed");
        require(!bidders[msg.sender].committed, "Bidder already committed");

        bidders[msg.sender].commitment = commitment;
        bidders[msg.sender].committed = true;
        bidderAddresses.push(msg.sender);

        emit BidCommitted(msg.sender, commitment);
    }

    /// @notice Opens the reveal window after the commit deadline.
    function startReveal() external onlyAuctioneer {
        require(phase == Phase.Commit, "Auction is not in commit phase");
        require(block.timestamp >= commitEnd, "Commit window is still open");

        phase = Phase.Reveal;
        revealEnd = block.timestamp + revealDuration;
        emit RevealPhaseStarted(revealEnd);
    }

    /// @notice Verify and store a bid. Intentionally does not calculate a winner.
    /// @param nonce A cryptographically random 32-byte secret generated by the bidder.
    function revealBid(uint256 bid, bytes32 nonce) external {
        require(phase == Phase.Reveal, "Reveal phase is not open");
        require(block.timestamp < revealEnd, "Reveal deadline has passed");

        Bidder storage bidder = bidders[msg.sender];
        require(bidder.committed, "No commitment found");
        require(!bidder.revealed, "Bid already revealed");
        require(bid > 0, "Bid must be positive");
        require(bid <= maxBid, "Bid exceeds classroom limit");
        require(
            keccak256(abi.encodePacked(bid, nonce)) == bidder.commitment,
            "Invalid reveal"
        );

        bidder.bid = bid;
        bidder.revealed = true;

        // No highestBid or winner update here: reveal ordering cannot affect the outcome.
        emit BidRevealed(msg.sender);
    }

    /// @notice Determine the winner only after no further reveal can be accepted.
    function finalizeAuction() external {
        require(phase == Phase.Reveal, "Auction cannot be finalized now");
        require(block.timestamp >= revealEnd, "Reveal window is still open");

        uint256 bestBid;
        address bestBidder;
        for (uint256 i = 0; i < bidderAddresses.length; i++) {
            address bidderAddress = bidderAddresses[i];
            Bidder storage bidder = bidders[bidderAddress];
            if (bidder.revealed && bidder.bid > bestBid) {
                bestBid = bidder.bid;
                bestBidder = bidderAddress;
            }
        }

        phase = Phase.Finalized;
        highestBid = bestBid;
        winner = bestBidder;
        if (bestBidder != address(0)) {
            resource.allocated = true;
            resource.allocatedTo = bestBidder;
        }

        emit AuctionFinalized(bestBidder, bestBid, resource.id);
    }

    function getAuctionResult()
        external
        view
        returns (Phase currentPhase, address currentWinner, uint256 winningBid, bool resourceAllocated)
    {
        return (phase, winner, highestBid, resource.allocated);
    }

    function getResource() external view returns (Resource memory) {
        return resource;
    }

    function committedBidderCount() external view returns (uint256) {
        return bidderAddresses.length;
    }
}
